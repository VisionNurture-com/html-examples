[{"filePath":"compare/005-aria-stages/index.html","messages":[{"ruleId":"prefer-native-element","severity":2,"message":"Prefer to use the native <button> element","offset":744,"line":23,"column":32,"size":13,"selector":"#s2","ruleUrl":"https://html-validate.org/rules/prefer-native-element.html","context":{"role":"button","replacement":"button"}},{"ruleId":"prefer-native-element","severity":2,"message":"Prefer to use the native <button> element","offset":887,"line":26,"column":32,"size":13,"selector":"#s3","ruleUrl":"https://html-validate.org/rules/prefer-native-element.html","context":{"role":"button","replacement":"button"}},{"ruleId":"prefer-native-element","severity":2,"message":"Prefer to use the native <button> element","offset":1047,"line":29,"column":32,"size":13,"selector":"#s4","ruleUrl":"https://html-validate.org/rules/prefer-native-element.html","context":{"role":"button","replacement":"button"}}],"errorCount":3,"warningCount":0,"source":"<!DOCTYPE html>\n<html lang=\"ja\">\n  <head>\n    <meta charset=\"utf-8\">\n    <title>div にどこまで足すと button に追いつくか</title>\n    <style>\n      .btn { display: inline-block; margin: 8px 0; padding: 8px 16px;\n             background: #2b6cb0; color: #fff; cursor: pointer; border: 0; font: inherit; }\n    </style>\n  </head>\n  <body>\n    <main>\n      <h1>div にどこまで足すと button に追いつくか</h1>\n      <p id=\"status\">まだ押していません。</p>\n\n      <!-- 段階 0: 素の div。フォーカスも役割も無い -->\n      <div id=\"s0\" class=\"btn\" onclick=\"hit('s0')\">段階 0：素の div</div>\n\n      <!-- 段階 1: tabindex だけ足す。フォーカスは当たるが役割は伝わらない -->\n      <div id=\"s1\" class=\"btn\" tabindex=\"0\" onclick=\"hit('s1')\">段階 1：tabindex だけ</div>\n\n      <!-- 段階 2: role だけ足す。役割は伝わるがフォーカスが当たらない -->\n      <div id=\"s2\" class=\"btn\" role=\"button\" onclick=\"hit('s2')\">段階 2：role だけ</div>\n\n      <!-- 段階 3: 両方足す。到達も役割も揃うが、Enter と Space では起動しない -->\n      <div id=\"s3\" class=\"btn\" role=\"button\" tabindex=\"0\" onclick=\"hit('s3')\">段階 3：role + tabindex</div>\n\n      <!-- 段階 4: キー処理を自分で書いて、ようやく button と同じ操作になる -->\n      <div id=\"s4\" class=\"btn\" role=\"button\" tabindex=\"0\" onclick=\"hit('s4')\"\n           onkeydown=\"if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); hit('s4'); }\">段階 4：+ キー処理</div>\n\n      <!-- 参照実装: 最初から全部そろっている -->\n      <button id=\"native\" type=\"button\" class=\"btn\" onclick=\"hit('native')\">参照：button</button>\n    </main>\n    <script>\n      function hit(id) {\n        document.getElementById('status').textContent = id + ' を押しました。';\n      }\n    </script>\n  </body>\n</html>\n"},{"filePath":"symptoms/005-heading-order/broken.html","messages":[{"ruleId":"unique-landmark","severity":2,"message":"Landmarks must have a non-empty and unique accessible name (aria-label or aria-labelledby)","offset":183,"line":9,"column":6,"size":4,"selector":"html > body > main:nth-child(1)","ruleUrl":"https://html-validate.org/rules/unique-landmark.html"},{"ruleId":"no-multiple-main","severity":2,"message":"Multiple <main> elements present in document","offset":402,"line":17,"column":6,"size":4,"selector":"html > body > main:nth-child(2)","ruleUrl":"https://html-validate.org/rules/no-multiple-main.html"},{"ruleId":"unique-landmark","severity":2,"message":"Landmarks must have a non-empty and unique accessible name (aria-label or aria-labelledby)","offset":402,"line":17,"column":6,"size":4,"selector":"html > body > main:nth-child(2)","ruleUrl":"https://html-validate.org/rules/unique-landmark.html"}],"errorCount":3,"warningCount":0,"source":"<!DOCTYPE html>\n<html lang=\"ja\">\n  <head>\n    <meta charset=\"utf-8\">\n    <title>見出しの階層が飛ぶページ</title>\n  </head>\n  <body>\n    <!-- ここが原因 1: main が 2 つある。支援技術は「主要な領域」を 1 つに絞れない -->\n    <main>\n      <h1>サポート窓口のご案内</h1>\n      <!-- ここが原因 2: h1 の次が h3。見出しの階層に h2 の段が無い -->\n      <h3>受付時間</h3>\n      <p>平日 9 時から 17 時まで受け付けます。</p>\n      <h3>連絡先</h3>\n      <p>support@example.com までお送りください。</p>\n    </main>\n    <main>\n      <!-- ここが原因 3: 2 つ目の main の中で h1 が再び現れる -->\n      <h1>よくある質問</h1>\n      <h4>返信までどのくらいかかりますか</h4>\n      <p>2 営業日以内にお返しします。</p>\n    </main>\n  </body>\n</html>\n"},{"filePath":"symptoms/005-table-semantics/broken.html","messages":[{"ruleId":"prefer-tbody","severity":2,"message":"Prefer to wrap <tr> elements in <tbody>","offset":234,"line":12,"column":10,"size":2,"selector":"html > body > main > table > tr:nth-child(1)","ruleUrl":"https://html-validate.org/rules/prefer-tbody.html"}],"errorCount":1,"warningCount":0,"source":"<!DOCTYPE html>\n<html lang=\"ja\">\n  <head>\n    <meta charset=\"utf-8\">\n    <title>表が誤読されるページ</title>\n  </head>\n  <body>\n    <main>\n      <h1>担当者ごとの受付件数</h1>\n      <!-- ここが原因 1: 表に caption が無い。何の表かが読み上げから分からない -->\n      <table>\n        <tr>\n          <!-- ここが原因 2: 見出しのセルが th ではなく td。行と列の見出しが伝わらない -->\n          <td>担当</td>\n          <td>4 月</td>\n          <td>5 月</td>\n        </tr>\n        <tr>\n          <td>Alice</td>\n          <td>12</td>\n          <td>18</td>\n        </tr>\n        <tr>\n          <td>Bob</td>\n          <td>9</td>\n          <td>21</td>\n        </tr>\n      </table>\n    </main>\n  </body>\n</html>\n"}]