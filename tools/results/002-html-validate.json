[{"filePath":"compare/002-a-vs-button-vs-div/index.html","messages":[{"ruleId":"prefer-native-element","severity":2,"message":"Prefer to use the native <button> element","offset":889,"line":34,"column":44,"size":13,"selector":"#impl-div-patched","ruleUrl":"https://html-validate.org/rules/prefer-native-element.html","context":{"role":"button","replacement":"button"}}],"errorCount":1,"warningCount":0,"source":"<!DOCTYPE html>\n<html lang=\"ja\">\n  <head>\n    <meta charset=\"utf-8\">\n    <title>a / button / div onclick の比較</title>\n    <style>\n      /* 3 つとも同じ見た目にする。見た目が同じであることが、この比較の前提 */\n      .btn {\n        display: inline-block;\n        padding: 8px 16px;\n        border: 1px solid #333;\n        border-radius: 4px;\n        background: #fff;\n        font: inherit;\n        color: #111;\n        text-decoration: none;\n        cursor: pointer;\n      }\n    </style>\n  </head>\n  <body>\n    <h1>同じ見た目の 3 つの実装</h1>\n\n    <!-- ① 行き先がある: a -->\n    <a class=\"btn\" id=\"impl-a\" href=\"./target.html\">お知らせを見る</a>\n\n    <!-- ② その場で起こす操作を、遷移に流用した例: button + スクリプト -->\n    <button class=\"btn\" id=\"impl-button\" type=\"button\">お知らせを見る</button>\n\n    <!-- ③ 対話性を持たない要素にクリックを付けた例: div -->\n    <div class=\"btn\" id=\"impl-div\">お知らせを見る</div>\n\n    <!-- ④ ③ に役割・フォーカス・キー操作を自分で足した例 -->\n    <div class=\"btn\" id=\"impl-div-patched\" role=\"button\" tabindex=\"0\">お知らせを見る</div>\n\n    <script>\n      const go = () => { location.href = './target.html'; };\n\n      document.getElementById('impl-button').addEventListener('click', go);\n      document.getElementById('impl-div').addEventListener('click', go);\n\n      const patched = document.getElementById('impl-div-patched');\n      patched.addEventListener('click', go);\n      patched.addEventListener('keydown', (event) => {\n        // ネイティブの button が既定で持っている挙動を、自分で書き足す\n        if (event.key === 'Enter' || event.key === ' ') {\n          event.preventDefault();\n          go();\n        }\n      });\n    </script>\n  </body>\n</html>\n"},{"filePath":"symptoms/002-anchor-id/broken.html","messages":[{"ruleId":"no-dup-id","severity":2,"message":"Duplicate ID \"plan\"","offset":728,"line":29,"column":20,"size":4,"selector":"html > body > main > section:nth-child(3)","ruleUrl":"https://html-validate.org/rules/no-dup-id.html"}],"errorCount":1,"warningCount":0,"source":"<!DOCTYPE html>\n<html lang=\"ja\">\n  <head>\n    <meta charset=\"utf-8\">\n    <title>ページ内リンクが飛ばないページ</title>\n    <style>\n      /* 上に固定されたヘッダー。飛んだ先がこの下に隠れる */\n      header { position: fixed; top: 0; left: 0; right: 0; height: 64px; background: #e8e8e8; }\n      main { padding-top: 64px; }\n      section { min-height: 600px; }\n    </style>\n  </head>\n  <body>\n    <header>サイトの見出し</header>\n    <main>\n      <nav>\n        <ul>\n          <li><a href=\"#plan\">料金プラン</a></li>\n          <li><a href=\"#support\">サポート</a></li>\n        </ul>\n      </nav>\n\n      <!-- ここが原因 1: 同じ id を 2 か所に書いている。#plan は先に現れた方へ飛ぶ -->\n      <section id=\"plan\">\n        <h2>料金プランの概要</h2>\n        <p>この節は導入です。読者が読みたいのは下の詳細表です。</p>\n      </section>\n\n      <section id=\"plan\">\n        <h2>料金プランの詳細</h2>\n        <p>読者が飛びたいのはこちらですが、上の節へ飛びます。</p>\n      </section>\n\n      <!-- ここが原因 2: id は一意だが、飛んだ先が固定ヘッダーの下に隠れる -->\n      <section id=\"support\">\n        <h2>サポート</h2>\n        <p>この見出しは、飛んだ直後にヘッダーの下へ入ります。</p>\n      </section>\n\n      <!-- 末尾の節はページの終わりで止まり、画面の上端まで来ない。\n           上の #support を上端まで運べるようにするための、後ろに続く内容 -->\n      <section id=\"company\">\n        <h2>会社案内</h2>\n        <p>後続の内容です。</p>\n      </section>\n    </main>\n  </body>\n</html>\n"},{"filePath":"symptoms/002-no-action/button-href.html","messages":[{"ruleId":"no-implicit-button-type","severity":2,"message":"<button> is missing recommended \"type\" attribute","offset":219,"line":11,"column":6,"size":6,"selector":"#broken","ruleUrl":"https://html-validate.org/rules/no-implicit-button-type.html"}],"errorCount":1,"warningCount":0,"source":"<!DOCTYPE html>\n<html lang=\"ja\">\n  <head>\n    <meta charset=\"utf-8\">\n    <title>ボタンを押しても遷移しないページ</title>\n  </head>\n  <body>\n    <h1>お申し込み</h1>\n\n    <!-- ここが原因: button に href を書いている。href は button の属性ではないため無視される -->\n    <button id=\"broken\" href=\"./target.html\">申し込みページへ</button>\n\n    <!-- 遷移させたいなら a を使う -->\n    <a id=\"fixed\" href=\"./target.html\">申し込みページへ（a で書いた場合）</a>\n  </body>\n</html>\n"}]